PORT=18282

# Required by tools/search_tools.py — see that file for setup steps.
# GOOGLE_API_KEY=${RAG_DEMO_GOOGLE_API_KEY:-}
# GOOGLE_CSE_ID=${RAG_DEMO_GOOGLE_CSE_ID:-}

# Required by langchain_demo/rag_demo.py's "redis" vector store backend.
# Bring up locally with: scripts/start_infra.sh
REDIS_URL=redis://localhost:6379

# Required by langchain_demo/rag_demo.py's "postgres" vector store backend.
# Bring up locally with: scripts/start_infra.sh
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_tutorial_rag

# Postgres superuser — only used to bootstrap the container and create the
# least-privilege app role below (docker/postgres/init/002-create-app-user.sh).
# The username is not sensitive, so it's a plain committed value. Only the
# password is indirected to a variable in YOUR shell environment —
# scripts/start.sh and scripts/start_infra.sh will prompt for it the first
# time if it isn't already set (see scripts/lib/env.sh).
POSTGRES_ROOT_USER=ai_tutorial_root
POSTGRES_ROOT_PASSWORD=${RAG_DEMO_PG_ROOT_PASSWORD:-}

# Postgres app user — least-privilege role the FastAPI app actually
# connects with at runtime (never the superuser above). Same split: plain
# username, indirected password.
POSTGRES_APP_USER=ai_tutorial_app
POSTGRES_APP_PASSWORD=${RAG_DEMO_PG_APP_PASSWORD:-}

# Default vector store backend for /langchain/rag/query when not specified.
# One of: memory | redis | postgres
RAG_DEFAULT_BACKEND=memory

# Required by langgraph_demo/rag/cohere_client.py, and ONLY if a
# /langgraph/rag/{session_id} request sets rewrite_eval=true, rerank=true,
# or generation_eval=true (all three default to false — no key needed at
# all for the default demo flow). Get a trial key at https://dashboard.cohere.com/api-keys.
# COHERE_API_KEY=${RAG_DEMO_COHERE_API_KEY:-}
